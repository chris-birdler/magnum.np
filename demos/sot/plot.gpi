set output "data/results.png"
set terminal pngcairo enhanced dashed size 1024,768
set termoption dash
set grid
set title "Spin Orbit Torque"
set xlabel "Magnetization m_x"
set ylabel "Magnetization m_y"

plot \
    'data/ref_magnumaf.dat' using 2:3 title "magnum.af" w p lw 2 ps 2 lc 1, \
    'data/ref_magnumnp.dat' using 2:3 title "magnum.np" w l dt 2 lw 3 lc 2, \
    'data/log.dat'          using 2:3 title "magnum.np" w l lc 2

