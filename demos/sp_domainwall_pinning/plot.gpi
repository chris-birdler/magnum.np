set output "data/results.png"
set terminal pngcairo enhanced dashed
set termoption dash
set grid
set title "Standard Problem - Domainwall Pinning"
set xlabel "Applied Field {/Symbol m}_0 H_{ext} [T]"
set ylabel "Magnetization m_y"

plot [1.4:1.8] \
    'data/m_dieter.dat' using 2:4 title "dieter" w l, \
    'data/m_magnumaf.dat' using ($5*4*pi*1e-7):3 title "magnum.af" w l, \
    'data/m_ref.dat' using ($3*4*pi*1e-7):6 title "magnum.np" w l, \
    'data/m.dat' using ($3*4*pi*1e-7):6 every 4 notitle w p lc 3
