set output "data/results.png"
set terminal pngcairo enhanced dashed
set termoption dash
set grid
set title "Soft Magnetic Composite"
set xlabel "H^{ext}_x [A/m]"
set ylabel "Magnetization m_x"

plot \
    'data/m.dat' using ($2*4*pi*1e-7):5 title "paul's method" w l, \
    'data/m.dat' using ($2*4*pi*1e-7):5 every 10 title "harmonic mean" w p
